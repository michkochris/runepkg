prefix=/home/michko/runepkg/runepkg/.forge_musl/deps
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP GOPHER HTTP IMAP IPFS IPNS MQTT POP3 RTSP SMTP TELNET TFTP"
supported_features="alt-svc AsynchDNS IPv6 Largefile libz threadsafe UnixSockets"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with ftp, http, etc.
Version: 8.9.1
Requires: zlib
Requires.private: zlib
Libs: -L${libdir} -lcurl -lz 
Libs.private: -lz
Cflags: -I${includedir} -DCURL_STATICLIB
