# - The system-wide location for this file is: /etc/runepkg/runepkgconfig

# [IMPORTANT]
# --- No Forward Slash In Linux ---
# - Do not leave a trailing forward slash (/) at the end of paths...
# - Use absolute Linux path names...

# [IMPORTANT]
# --- Path Expansion! Features ---
# runepkg supports dynamic expansion for all path settings:
#
# 1- Tilde Expansion (~):
#    Expands to the current user's HOME directory.
#    Example: runepkg_dir=~/runepkg_dir
#
# 2- Variable Expansion (${VAR}):
#    Expands environment variables.
#    Example: runepkg_db=${HOME}/.runepkg/db
#
# 3- Command Expansion (${pwd}):
#    Expands to the current working directory where runepkg is executed.
#    Example: install_dir=${pwd}/local_root

# [IMPORTANT]
# --------------------------- Environment Variables ------------------------------------------------ #
# RUNEPKG_CONFIG_PATH:
#   Points to a custom location for this configuration file.
RUNEPKG_CONFIG_PATH=

# [IMPORTANT]
# --------------------------- Core Pathways (FHS Compliant) ---------------------------------------- #

# [runepkg_dir]
# Necessary base directory for runepkg sub-directories.
runepkg_dir=/srv/lib/runepkg_dir

# [download_dir]
# Necessary Cache directory where downloaded .deb's and sources are stored.
download_dir=/srv/lib/runepkg_dir/download_dir

# [control_dir]
# Necessary temporary workspace where .deb control archives are extracted while processing.
control_dir=/srv/lib/runepkg_dir/control_dir

# [build_dir]
# Necessary standard workspace for building and unpacking packages locally.
build_dir=/srv/lib/runepkg_dir/build_dir

# [target_arch]
# Explicit target architecture for multi-arch cross-staging (e.g. amd64, arm64, riscv64).
target_arch=amd64:x86_64-linux-gnu
#target_arch=arm64:aarch64-linux-gnu

# [install_dir]
# Indefinite target root for package installation (set to '/' for system-wide).
install_dir=/
#install_dir=/srv/lib/runepkg_dir/install_dir

# [runepkg_db]
# Persistent storage location for {HOST} package manager's state.
# Can `runepkg sync` to sync host dpkg installed packages via dpkg entanglement...
runepkg_db=/srv/lib/runepkg_dir/runepkg_db

# [target_sysroot]
# Dedicated cross-arch embedded target sysroot for runepkg_psychic multi-arch staging and Matryoshka staging.
# When enabled, packages extract safely into sysroot without mutating live host root / (default: /srv/lib/runepkg_dir/target_sysroot).
target_sysroot=/srv/lib/runepkg_dir/target_sysroot

# [target_deb]
# Dedicated output directory for isolated Debian compatible {cross} built .deb files.
target_deb=/srv/lib/runepkg_dir/target_deb

# --------------------------- Behavior Settings ------------------------------------------------------- #

# [cleanup]
# Automatically delete extraction workspace after installation (yes/no).
cleanup=yes

# [md5_checks]
# Enable MD5 integrity verification during installation (yes/no).
md5_checks=yes

# [dpkg_host]
# available options: auto, none...
# Quantum entanglement toggle with the host system's dpkg registry (auto/none).
#
# - auto: Automatically remove all traces of dpkg host packages (files, metadata, lists) without running Debian pre/post-removal scripts.
# - none: Isolated mode. Keeps host dpkg untouched; safe for new users.
#
dpkg_host=auto

# [gpg_check]
# Enable GPG cryptographic signature verification for packages during install (yes/no).
# currently a future proof feature, as no current debian based distro ever signs a .deb with a gpg signature...
gpg_check=no

# --------------------------- Matryoshka & Rescue Runner Policy ---------------------------------------- #
# 1- Static musl Rescue Binary: Compiled with `make musl-all` (zero dynamic linkage to host glibc/ld.so).
# 2- Core Lock Guard: On live host root '/', core glibc & toolchain packages (libc6, libgcc-s1, ld-linux)
#    are locked by default unless --allow-core-runtime-on-root is passed.
# 3- Matryoshka Ordering:
#    - Stage 0: Deepest Doll (base runtime: libc6, ld-linux*, libgcc-s1, gcc-base)
#    - Stage 1: Middle Doll (support modules: libc-gconv-modules-extra, libmagic)
#    - Stage 2: Outer Doll (leaf application utilities: file, grep, curl)

# --- Repository Sources ---
# runepkg supports standard Debian sources.list syntax.
#
# IMPORTANT: It is highly recommended to use ONLY ONE distribution ecosystem
# at a time (e.g., just Kali, or just Debian Stable). While runepkg can aggregate
# metadata from multiple sources, the current URL resolver prefers the first
# base URL defined. Mixing repositories with different base URLs may cause
# download failures (404) if a package exists in one but not the other.

# [Debian Stable (Trixie)] - RECOMMENDED FOR STABLE RUNEPKG DEPLOYMENTS
# Debian Stable provides frozen, reliable package versions that prevent 404 mirror pruning errors.
#deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware
#deb http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware
#deb http://deb.debian.org/debian trixie-backports main contrib non-free non-free-firmware
#deb-src http://deb.debian.org/debian trixie main contrib non-free non-free-firmware

# [Kali Linux Rolling] - OPTIONAL ROLLING RELEASE FOR RUNEPKG
# Note: Rolling mirrors frequently prune older package versions, which can cause 404 download errors.
deb http://http.kali.org/kali kali-rolling main contrib non-free non-free-firmware
deb-src http://http.kali.org/kali kali-rolling main contrib non-free non-free-firmware

# Debian Ports (for extra/ports arches: loong64, riscv64, alpha, hppa, m68k, sh4, sparc64)
#deb http://ftp.ports.debian.org/debian-ports sid main

