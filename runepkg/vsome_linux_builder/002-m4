#!/usr/bin/env bash
#/******************************************************************************
# * Filename:    002-m4
# * Author:      <michkochris@gmail.com>
# * Description: m4 macro processor for the crosstools forge
# ******************************************************************************/

. ./somelinuxconfig
somelinux_ensure_loaded

# --- Build Configuration ---
# Find the rules file dynamically
RULES_PATH=$(find "$SOMESRC" -path "*/m4-*/debian/rules" | head -n 1)

if [[ -f "$RULES_PATH" ]]; then
    echo "  [config] Updating debian/rules..."
    cat << EOF > "$RULES_PATH"
#!/usr/bin/make -f
LDFLAGS += $(FORGE_LDFLAGS)
%:
	dh \$@

override_dh_auto_configure:
	dh_auto_configure -- \\
		--prefix=/crosstools \\
		--libdir=/crosstools/lib/\$(DEB_HOST_MULTIARCH) \\
		LDFLAGS="\$(LDFLAGS)"
EOF
    chmod +x "$RULES_PATH"

    echo "  [config] Adjusting .install files..."
    find "$(dirname "$RULES_PATH")" -name "*.install" -exec sed -i "s|^usr/|crosstools/|g" {} +
fi

# --- Build Automation ---
# Trigger the forge build using the modified rules and install files
echo "  [forge] Ritual initiated: assembly of m4-crosstools..."
runepkg buildpkg-split "m4"

somelinux_exit "The forge ritual for m4-crosstools is complete." 0
