#!/usr/bin/env bash
#/******************************************************************************
# * Filename:    012-musl
# * Author:      <michkochris@gmail.com>
# * Description: Musl Libc for the crosstools forge
# ******************************************************************************/

. ./somelinuxconfig
somelinux_ensure_loaded

# --- Build Configuration ---
# Find the rules file dynamically
RULES_PATH=$(find "$SOMESRC" -path "*/musl-*/debian/rules" | head -n 1)

if [[ -f "$RULES_PATH" ]]; then
    echo "  [config] Updating debian/rules for Musl..."
    cat << EOF > "$RULES_PATH"
#!/usr/bin/make -f
LDFLAGS += $(FORGE_LDFLAGS)
%:
	dh \$@

override_dh_auto_configure:
	# Use the Pass 1 toolchain to build musl
	CROSS_COMPILE=\$(CLFS_TARGET)- dh_auto_configure -- \\
		--prefix=/usr \\
		--libdir=/usr/lib/\$(DEB_TARGET_MULTIARCH) \\
		--syslibdir=/lib \\
		LDFLAGS="\$(LDFLAGS)"
EOF
    chmod +x "$RULES_PATH"

    echo "  [config] Adjusting .install files..."
    find "$(dirname "$RULES_PATH")" -name "*.install" -exec sed -i "s|^usr/|crosstools/|g" {} +
fi

# --- Build Automation ---
echo "  [forge] Ritual initiated: assembly of musl-crosstools..."
runepkg buildpkg-split "musl"

somelinux_exit "The forge ritual for musl-crosstools is complete." 0
