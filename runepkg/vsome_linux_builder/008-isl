#!/usr/bin/env bash
#/******************************************************************************
# * Filename:    008-isl
# * Author:      <michkochris@gmail.com>
# * Description: ISL for the crosstools forge
# ******************************************************************************/

. ./somelinuxconfig
somelinux_ensure_loaded

# --- Build Configuration ---
# Find the rules file dynamically
RULES_PATH=$(find "$SOMESRC" -path "*/isl-*/debian/rules" | head -n 1)

if [[ -f "$RULES_PATH" ]]; then
    echo "  [config] Updating debian/rules for ISL..."
    cat << EOF > "$RULES_PATH"
#!/usr/bin/make -f
LDFLAGS += $(FORGE_LDFLAGS)
%:
	dh \$@

override_dh_auto_configure:
	dh_auto_configure -- \\
		--prefix=/crosstools \\
		--libdir=/crosstools/lib/\$(DEB_HOST_MULTIARCH) \\
		--with-gmp-prefix=/crosstools \\
		LDFLAGS="\$(LDFLAGS)"
EOF
    chmod +x "$RULES_PATH"

    echo "  [config] Adjusting .install files..."
    find "$(dirname "$RULES_PATH")" -name "*.install" -exec sed -i "s|^usr/|crosstools/|g" {} +
    find "$(dirname "$RULES_PATH")" -name "*.install" -exec sed -i "s|lib/\*/|lib/$DEB_HOST_MULTIARCH/|g" {} +
fi

# --- Build Automation ---
# Trigger the forge build using the modified rules and install files
echo "  [forge] Ritual initiated: assembly of isl-crosstools..."
runepkg buildpkg-split "isl"

somelinux_exit "The forge ritual for isl-crosstools is complete." 0
