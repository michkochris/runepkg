#!/usr/bin/env bash
#/******************************************************************************
# * Filename:    009-binutils
# * Author:      <michkochris@gmail.com>
# * Description: Binutils for the crosstools forge (Pass 1)
# ******************************************************************************/

. ./somelinuxconfig
somelinux_ensure_loaded

# --- Build Configuration ---
# Find the rules file dynamically
RULES_PATH=$(find "$SOMESRC" -path "*/binutils-*/debian/rules" | head -n 1)

if [[ -f "$RULES_PATH" ]]; then
    echo "  [config] Updating debian/rules for Binutils Pass 1..."
    cat << EOF > "$RULES_PATH"
#!/usr/bin/make -f
LDFLAGS += $(FORGE_LDFLAGS)
%:
	dh \$@

override_dh_auto_configure:
	dh_auto_configure -- \\
		--prefix=/crosstools \\
		--with-sysroot=\$(CLFS) \\
		--target=\$(CLFS_TARGET) \\
		--disable-nls \\
		--disable-werror \\
		--libdir=/crosstools/lib/\$(DEB_HOST_MULTIARCH) \\
		LDFLAGS="\$(LDFLAGS)"
EOF
    chmod +x "$RULES_PATH"

    echo "  [config] Adjusting .install files..."
    find "$(dirname "$RULES_PATH")" -name "*.install" -exec sed -i "s|^usr/|crosstools/|g" {} +
    find "$(dirname "$RULES_PATH")" -name "*.install" -exec sed -i "s|lib/\*/|lib/$DEB_HOST_MULTIARCH/|g" {} +
fi

# --- Build Automation ---
# Trigger the forge build using the modified rules and install files
echo "  [forge] Ritual initiated: assembly of binutils-crosstools..."
runepkg buildpkg-split "binutils"

somelinux_exit "The forge ritual for binutils-crosstools is complete." 0
